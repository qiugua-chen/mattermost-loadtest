worker_processes auto;
worker_rlimit_nofile 65535;

pid logs/nginx.pid;
error_log logs/error.log warn;

events {
    use epoll;
    worker_connections 8192;
}

http {
    default_type application/octet-stream;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      '';
    }

    log_format perf
        '$msec|$request_method|$uri|$status|'
        '$request_time|$upstream_response_time|$body_bytes_sent';

    upstream mattermost_backend {
        server mattermost.example.com:8065;
        keepalive 2048;
    }

    server {
        listen 127.0.0.1:18065 backlog=65535;

        access_log logs/access.log perf buffer=256k flush=1s;

        location = /nginx_status {
            stub_status;
            access_log off;
            allow 127.0.0.1;
            deny all;
        }

        location / {
            proxy_pass http://mattermost_backend;
            proxy_http_version 1.1;

            proxy_set_header Host mattermost.example.com:8065;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto http;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            proxy_connect_timeout 10s;
            proxy_send_timeout 3600s;
            proxy_read_timeout 3600s;

            proxy_buffering off;
            proxy_request_buffering off;
        }
    }
}
