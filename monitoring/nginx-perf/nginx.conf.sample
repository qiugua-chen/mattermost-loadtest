# =============================================================================
# nginx-perf —— 链路层全量 HTTP 采集代理（监控子系统的数据底座）
#
# 定位：部署在压测机上，监听 127.0.0.1:18065，反向代理到真实 Mattermost。
# 压测配置（config.json）中的 ServerURL/WebSocketURL 指向本代理（18065），
# 所有压测 HTTP 流量经过此处落 access.log（含 request_time/upstream_time），
# 供 scripts/summarize_http_perf.py 做延迟/吞吐/错误率分析。
#
# 使用方法：
#   1. cp nginx.conf.sample nginx.conf
#   2. 把 upstream 与 Host 头中的 mattermost.example.com:8065 改为真实被测地址
#   3. mkdir -p logs && nginx -p $PWD -c nginx.conf   （以本目录为前缀启动）
# =============================================================================

worker_processes auto;
# 单进程可打开文件数上限：压测并发连接多，必须放大，避免 "too many open files"
worker_rlimit_nofile 65535;

pid logs/nginx.pid;
error_log logs/error.log warn;

events {
    use epoll;
    # 单 worker 最大连接数：需 >= 预期并发连接数（含 WS 长连接）
    worker_connections 8192;
}

http {
    default_type application/octet-stream;

    # WebSocket 升级头映射：有 Upgrade 头时透传 upgrade，否则置空
    # （WS 长连接能穿过本代理是"链路层观测不破坏被测协议"的关键）
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      '';
    }

    # perf 日志格式（管道符分隔），各汇总脚本按此列序解析，改动需同步脚本：
    #   $1 时间戳(毫秒) $2 方法 $3 URI $4 状态码
    #   $5 客户端视角耗时 $6 上游(Mattermost)耗时 $7 响应字节数
    log_format perf
        '$msec|$request_method|$uri|$status|'
        '$request_time|$upstream_response_time|$body_bytes_sent';

    upstream mattermost_backend {
        # 真实被测 Mattermost 地址（替换为你的环境）
        server mattermost.example.com:8065;
        # 到上游的长连接池：避免压测高并发下频繁建连扭曲测量结果
        keepalive 2048;
    }

    server {
        # 仅监听本机回环：只服务本机 ltagent，不对外暴露
        # backlog 放大以承受突发并发建连
        listen 127.0.0.1:18065 backlog=65535;

        # buffer+flush：批量异步写盘，避免日志 IO 成为代理层瓶颈
        access_log logs/access.log perf buffer=256k flush=1s;

        # nginx 自带状态页（活跃连接数等），供监控脚本采集；仅允许本机访问
        location = /nginx_status {
            stub_status;
            access_log off;
            allow 127.0.0.1;
            deny all;
        }

        location / {
            proxy_pass http://mattermost_backend;
            proxy_http_version 1.1;

            # Host 头保持为真实后端地址（Mattermost 对 Host 有站点 URL 校验）
            proxy_set_header Host mattermost.example.com:8065;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto http;

            # WebSocket 升级头透传
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # WS 长连接要求长读超时（默认 60s 会切断空闲 WS）；写超时同理
            proxy_connect_timeout 10s;
            proxy_send_timeout 3600s;
            proxy_read_timeout 3600s;

            # 关闭缓冲：实时性优先，避免消息在代理层排队影响延迟测量
            proxy_buffering off;
            proxy_request_buffering off;
        }
    }
}
