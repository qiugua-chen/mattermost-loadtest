# =============================================================================
# message-run.env —— 消息场景一键执行的便捷封装
#
# 作用：把 scripts/lt_run_message.sh 包装成 shell 函数 lt_run_message，
# 执行完毕后自动 source 本次运行产出的 current-message-run.env
# （内含运行目录、日志路径等），方便紧接着执行结果汇总命令。
# 使用：source 本文件后，直接调用 lt_run_message <参数...>
# =============================================================================

lt_run_message() {
  # 调用真正的执行脚本（透传全部参数）
  "$LT_ROOT/scripts/lt_run_message.sh" "$@"
  local run_rc=$?

  # 回读本次运行的环境产物（运行目录/日志位置等），供后续汇总命令使用
  if [ -r "$LT_ROOT/runtime/env/current-message-run.env" ]
  then
    source "$LT_ROOT/runtime/env/current-message-run.env"
  fi

  return "$run_rc"
}

export -f lt_run_message
