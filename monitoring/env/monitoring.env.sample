export MESSAGE_CONFIG="$LT_ROOT/config/formal/config-message-1200.json"

export GROUP_CONFIG="$LT_ROOT/config/formal/config-group-1200.json"
export GROUP_CONTROLLER_CONFIG="$LT_ROOT/config/formal/simplecontroller-group.json"

lt_run_monitored_scenario() {
    local scenario="${1:?缺少场景编号}"
    local users="${2:?缺少用户数}"
    local duration="${3:?缺少持续时间}"
    local base_config="${4:?缺少基础配置}"
    local controller_config="${5:-}"
    local expected_receivers="${6:-0}"

    local run_time
    local run_exit
    local metrics_collector_pid=""
    local pidstat_pid=""
    local sar_pid=""

    if [ ! -s "$base_config" ]; then
        echo "ERROR：场景配置不存在：$base_config"
        return 1
    fi

    run_time=$(date +%Y%m%d_%H%M%S)

    export CURRENT_USERS="$users"
    export CURRENT_DURATION="$duration"
    export CURRENT_RUN_ID="${scenario}_${users}U_${run_time}"
    export CURRENT_RUN_DIR="$RESULTS_ROOT/$CURRENT_RUN_ID"

    export CURRENT_CONSOLE="$CURRENT_RUN_DIR/console.log"
    export CURRENT_ACCESS_LOG="$CURRENT_RUN_DIR/http-access.log"
    export CURRENT_NGINX_ERROR="$CURRENT_RUN_DIR/nginx-error.log"
    export CURRENT_EXIT_FILE="$CURRENT_RUN_DIR/exit_code.txt"
    export CURRENT_STATUS_FILE="$CURRENT_RUN_DIR/ltagent-status.csv"
    export CURRENT_PROXY_CONFIG="$CURRENT_RUN_DIR/config-proxy.json"

    mkdir -p "$CURRENT_RUN_DIR"

    jq \
      --arg server_url "$PROXY_SERVER_URL" \
      --arg websocket_url "$PROXY_WEBSOCKET_URL" \
      '.ConnectionConfiguration.ServerURL = $server_url
       | .ConnectionConfiguration.WebSocketURL = $websocket_url
       | del(.ServerURL)
       | del(.WebSocketURL)' \
      "$base_config" \
      > "$CURRENT_PROXY_CONFIG" || return 1

    if ! jq empty "$CURRENT_PROXY_CONFIG" >/dev/null 2>&1; then
        echo "ERROR：代理配置生成失败"
        return 1
    fi

    lt_proxy_start || return 1

    sleep 2

    : > "$PERF_PROXY_ROOT/logs/access.log"
    : > "$PERF_PROXY_ROOT/logs/error.log"

    cd "$LT_ROOT" || return 1

    local command=(
      ./bin/ltagent
      -c "$CURRENT_PROXY_CONFIG"
      -n "$CURRENT_USERS"
      -d "$CURRENT_DURATION"
      --user-prefix "$LT_USER_PREFIX"
      --user-offset="$LT_USER_OFFSET"
    )

    if [ -n "$controller_config" ]; then
        if [ ! -s "$controller_config" ]; then
            echo "ERROR：Controller配置不存在：$controller_config"
            lt_proxy_stop
            return 1
        fi

        command+=(--controller-config "$controller_config")
    fi

    echo "========== 本轮场景 =========="
    echo "场景=$scenario"
    echo "用户数=$users"
    echo "持续时间=${duration}s"
    echo "运行目录=$CURRENT_RUN_DIR"
    printf '执行命令='
    printf '%q ' "${command[@]}"
    echo

    "${command[@]}" \
      > >(tee "$CURRENT_CONSOLE") 2>&1 &

    export LT_PID=$!

    "$LT_ROOT/scripts/collect_ltagent_metrics.sh" \
      "$CURRENT_RUN_DIR" \
      "$CURRENT_USERS" \
      "http://127.0.0.1:4001" \
      > "$CURRENT_RUN_DIR/metrics-collector.log" 2>&1 &

    metrics_collector_pid=$!

    pidstat \
      -h \
      -u \
      -r \
      -d \
      -p "$LT_PID" \
      1 \
      > "$CURRENT_RUN_DIR/ltagent-pidstat.log" &

    pidstat_pid=$!

    sar \
      -n DEV,TCP,ETCP \
      1 \
      > "$CURRENT_RUN_DIR/ltagent-network.log" &

    sar_pid=$!

    wait "$LT_PID"
    run_exit=$?

    kill \
      "$metrics_collector_pid" \
      "$pidstat_pid" \
      "$sar_pid" \
      2>/dev/null || true

    wait \
      "$metrics_collector_pid" \
      "$pidstat_pid" \
      "$sar_pid" \
      2>/dev/null || true

    echo "$run_exit" > "$CURRENT_EXIT_FILE"

    lt_proxy_stop

    cp -a \
      "$PERF_PROXY_ROOT/logs/access.log" \
      "$CURRENT_ACCESS_LOG"

    cp -a \
      "$PERF_PROXY_ROOT/logs/error.log" \
      "$CURRENT_NGINX_ERROR"

    "$LT_ROOT/scripts/summarize_http_perf.sh" \
      "$CURRENT_ACCESS_LOG" \
      "$CURRENT_DURATION" \
      > "$CURRENT_RUN_DIR/http-summary.txt" 2>&1 || true

    if [ "$scenario" = "S01_LOGIN" ]; then
        "$LT_ROOT/scripts/summarize_http_perf.sh" \
          "$CURRENT_ACCESS_LOG" \
          "$CURRENT_DURATION" \
          "/api/v4/users/login" \
          "POST" \
          > "$CURRENT_RUN_DIR/login-summary.txt" 2>&1 || true
    fi

    if [ "$scenario" = "S02_MESSAGE" ] || [ "$scenario" = "S03_GROUP" ]; then
        "$LT_ROOT/scripts/summarize_http_perf.sh" \
          "$CURRENT_ACCESS_LOG" \
          "$CURRENT_DURATION" \
          "/api/v4/posts" \
          "POST" \
          > "$CURRENT_RUN_DIR/post-api-summary.txt" 2>&1 || true

        "$LT_ROOT/scripts/summarize_message_metrics.sh" \
          "$CURRENT_ACCESS_LOG" \
          "$CURRENT_STATUS_FILE" \
          "$CURRENT_DURATION" \
          "$expected_receivers" \
          > "$CURRENT_RUN_DIR/message-summary.txt" 2>&1 || true
    fi

    echo "========== 本轮产物 =========="

    find "$CURRENT_RUN_DIR" \
      -maxdepth 1 \
      -type f \
      -printf '%f %s bytes\n' |
    sort

    echo "ltagent退出码=$run_exit"

    return "$run_exit"
}

lt_run_login() {
    local users="${1:?用法：lt_run_login <用户数> [持续时间]}"
    local duration="${2:-300}"

    lt_run_monitored_scenario \
      "S01_LOGIN" \
      "$users" \
      "$duration" \
      "$LOGIN_CONFIG"
}

lt_run_message() {
    local users="${1:?用法：lt_run_message <用户数> <持续时间> <每条消息预期接收人数>}"
    local duration="${2:?缺少持续时间}"
    local receivers="${3:?缺少每条消息预期接收人数}"

    lt_run_monitored_scenario \
      "S02_MESSAGE" \
      "$users" \
      "$duration" \
      "$MESSAGE_CONFIG" \
      "$MESSAGE_CONTROLLER_CONFIG" \
      "$receivers"
}

lt_run_group() {
    local users="${1:?用法：lt_run_group <用户数> <持续时间> <每条消息预期接收人数>}"
    local duration="${2:?缺少持续时间}"
    local receivers="${3:?缺少每条消息预期接收人数}"

    lt_run_monitored_scenario \
      "S03_GROUP" \
      "$users" \
      "$duration" \
      "$GROUP_CONFIG" \
      "$GROUP_CONTROLLER_CONFIG" \
      "$receivers"
}
export LT_METRICS_URL=http://127.0.0.1:4001/metrics
export LT_STATUS_URL=http://127.0.0.1:4001/status
export NGINX_STATUS_URL=http://127.0.0.1:18065/nginx_status
export NGINX_ACCESS_LOG="$LT_ROOT/runtime/nginx-perf/logs/access.log"
