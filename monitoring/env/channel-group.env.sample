# =============================================================================
# channel-group.env —— S03B 频道群发场景环境定义
#
# 场景说明：单个频道内 N 个发送者发消息、M 个接收者收消息，
# 用于验证"广播放大"（一条消息触发 N 个 WebSocket 推送）场景下的服务端性能。
# 依赖：需先 source loadtest.env（提供 $LT_ROOT）。
# =============================================================================

# 是否复用已存在的频道（1=复用下面指定的频道；0=由脚本新建）
export LT_CHANNEL_GROUP_USE_EXISTING_CHANNEL=1
# 目标团队/频道标识（获取方法见 target.env 注释）
export LT_CHANNEL_GROUP_TEAM_ID=YOUR_TEAM_ID
export LT_CHANNEL_GROUP_TEAM_NAME=loadtest-team
export LT_CHANNEL_GROUP_CHANNEL_ID=YOUR_CHANNEL_ID
export LT_CHANNEL_GROUP_CHANNEL_NAME=town-square
# 场景使用的控制器配置与基础配置（相对 $LT_ROOT，勿写绝对路径以保证可移植）
export CHANNEL_GROUP_CONTROLLER_CONFIG="$LT_ROOT/config/formal/simplecontroller-channel-group.json"
export CHANNEL_GROUP_CONFIG="$LT_ROOT/config/formal/config-channel-group-1200.json"
