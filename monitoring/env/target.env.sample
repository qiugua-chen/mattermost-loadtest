# =============================================================================
# target.env —— 被测目标环境定义（团队/频道标识）
#
# 作用：告诉压测脚本"在哪个团队、哪个频道"执行消息类场景。
# ID 获取方式（需先 export MM_TOKEN=<管理员 token>）：
#   curl -H "Authorization: Bearer $MM_TOKEN" \
#     http://<服务器>/api/v4/teams/name/<团队名>                      # 返回 JSON 的 id 即 TEAM_ID
#   curl -H "Authorization: Bearer $MM_TOKEN" \
#     http://<服务器>/api/v4/teams/<TEAM_ID>/channels/name/<频道名>   # 返回 CHANNEL_ID
# =============================================================================

# 团队名称（URL 中的 name，非显示名）
export TEAM_NAME=loadtest-team
# 团队 ID（26 位字母数字）
export TEAM_ID=YOUR_TEAM_ID
# 频道名称（URL 中的 name）
export CHANNEL_NAME=town-square
# 频道 ID
export CHANNEL_ID=YOUR_CHANNEL_ID
