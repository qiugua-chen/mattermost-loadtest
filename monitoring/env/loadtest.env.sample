export LT_ROOT="/opt/mattermost-load-test-ng"

export MM_SERVER="http://mattermost.example.com:8065"
export MM_WEBSOCKET="ws://mattermost.example.com:8065"

export LOGIN_CONFIG="$LT_ROOT/config/formal/config-login-1200.json"

export PERF_PROXY_ROOT="$LT_ROOT/runtime/nginx-perf"
export PROXY_SERVER_URL="http://127.0.0.1:18065"
export PROXY_WEBSOCKET_URL="ws://127.0.0.1:18065"

export RESULTS_ROOT="$LT_ROOT/results/runs"

export LT_USER_PREFIX="imlts01"
export LT_USER_OFFSET="-1"
export LT_METRICS_ADDR="127.0.0.1:4001"

export PATH="$LT_ROOT/bin:$PATH"

lt_env_check() {
    echo "========== 固定环境 =========="
    echo "项目目录=$LT_ROOT"
    echo "Mattermost=$MM_SERVER"
    echo "基础配置=$LOGIN_CONFIG"
    echo "Nginx目录=$PERF_PROXY_ROOT"
    echo "HTTP代理=$PROXY_SERVER_URL"
    echo "WebSocket代理=$PROXY_WEBSOCKET_URL"
    echo "结果根目录=$RESULTS_ROOT"

    if [ ! -d "$LT_ROOT" ]; then
        echo "ERROR：项目目录不存在"
        return 1
    fi

    if [ ! -s "$LOGIN_CONFIG" ]; then
        echo "ERROR：基础登录配置不存在或为空：$LOGIN_CONFIG"
        return 1
    fi

    if ! jq -e '
      (.ConnectionConfiguration.ServerURL | type == "string")
      and
      (.ConnectionConfiguration.WebSocketURL | type == "string")
      and
      (has("ServerURL") | not)
      and
      (has("WebSocketURL") | not)
    ' "$LOGIN_CONFIG" >/dev/null; then
        echo "ERROR：基础登录配置结构不正确"
        return 1
    fi

    if [ ! -x "$LT_ROOT/bin/ltagent" ]; then
        echo "ERROR：ltagent不存在或不可执行"
        return 1
    fi

    if ! command -v nginx >/dev/null 2>&1; then
        echo "ERROR：Nginx尚未安装"
        return 1
    fi

    if [ ! -s "$PERF_PROXY_ROOT/nginx.conf" ]; then
        echo "ERROR：独立Nginx配置不存在"
        return 1
    fi

    echo "环境检查=PASS"
}

lt_proxy_start() {
    if [ -s "$PERF_PROXY_ROOT/logs/nginx.pid" ]; then
        local old_pid
        old_pid=$(cat "$PERF_PROXY_ROOT/logs/nginx.pid")

        if kill -0 "$old_pid" 2>/dev/null; then
            echo "Nginx压测代理已经运行，PID=$old_pid"
            return 0
        fi
    fi

    nginx \
      -p "$PERF_PROXY_ROOT/" \
      -c nginx.conf \
      -t || return 1

    nginx \
      -p "$PERF_PROXY_ROOT/" \
      -c nginx.conf || return 1

    sleep 1

    local proxy_http
    proxy_http=$(
      curl -sS \
        -o /tmp/mm-proxy-ping.json \
        -w '%{http_code}' \
        "$PROXY_SERVER_URL/api/v4/system/ping"
    )

    echo "代理健康检查HTTP状态=$proxy_http"

    if [ "$proxy_http" != "200" ]; then
        echo "ERROR：Nginx代理无法访问Mattermost"
        cat "$PERF_PROXY_ROOT/logs/error.log"
        return 1
    fi

    curl -sS "$PROXY_SERVER_URL/nginx_status"
}

lt_proxy_stop() {
    if [ ! -s "$PERF_PROXY_ROOT/logs/nginx.pid" ]; then
        echo "Nginx压测代理未运行"
        return 0
    fi

    nginx \
      -p "$PERF_PROXY_ROOT/" \
      -c nginx.conf \
      -s quit

    local i

    for i in $(seq 1 20); do
        if [ ! -s "$PERF_PROXY_ROOT/logs/nginx.pid" ]; then
            break
        fi

        sleep 1
    done
}

lt_prepare_login() {
    local users="${1:?用法：lt_prepare_login <用户数> [持续秒数]}"
    local duration="${2:-300}"
    local run_time

    lt_env_check || return 1

    run_time=$(date +%Y%m%d_%H%M%S)

    export CURRENT_USERS="$users"
    export CURRENT_DURATION="$duration"
    export CURRENT_RUN_ID="S01_LOGIN_${users}U_${run_time}"
    export CURRENT_RUN_DIR="$RESULTS_ROOT/$CURRENT_RUN_ID"

    export CURRENT_CONSOLE="$CURRENT_RUN_DIR/console.log"
    export CURRENT_ACCESS_LOG="$CURRENT_RUN_DIR/http-access.log"
    export CURRENT_NGINX_ERROR="$CURRENT_RUN_DIR/nginx-error.log"
    export CURRENT_EXIT_FILE="$CURRENT_RUN_DIR/exit_code.txt"
    export PROXY_LOGIN_CONFIG="$CURRENT_RUN_DIR/config-login-proxy.json"

    mkdir -p "$CURRENT_RUN_DIR"

    jq \
      --arg server_url "$PROXY_SERVER_URL" \
      --arg websocket_url "$PROXY_WEBSOCKET_URL" \
      '.ConnectionConfiguration.ServerURL = $server_url
       | .ConnectionConfiguration.WebSocketURL = $websocket_url
       | del(.ServerURL)
       | del(.WebSocketURL)' \
      "$LOGIN_CONFIG" \
      > "$PROXY_LOGIN_CONFIG" || return 1

    if ! jq empty "$PROXY_LOGIN_CONFIG" >/dev/null 2>&1; then
        echo "ERROR：代理配置生成失败"
        return 1
    fi

    lt_proxy_start || return 1

    sleep 2

    : > "$PERF_PROXY_ROOT/logs/access.log"
    : > "$PERF_PROXY_ROOT/logs/error.log"

    echo "========== 本轮运行环境 =========="
    echo "运行ID=$CURRENT_RUN_ID"
    echo "用户数=$CURRENT_USERS"
    echo "持续时间=$CURRENT_DURATION"
    echo "运行目录=$CURRENT_RUN_DIR"
    echo "运行配置=$PROXY_LOGIN_CONFIG"
    echo "控制台日志=$CURRENT_CONSOLE"
    echo "HTTP日志=$CURRENT_ACCESS_LOG"

    jq '{
      ServerURL: .ConnectionConfiguration.ServerURL,
      WebSocketURL: .ConnectionConfiguration.WebSocketURL,
      Controller: .UserControllerConfiguration.Type
    }' "$PROXY_LOGIN_CONFIG"
}

lt_finish_run() {
    lt_proxy_stop

    if [ -f "$PERF_PROXY_ROOT/logs/access.log" ]; then
        cp -a \
          "$PERF_PROXY_ROOT/logs/access.log" \
          "$CURRENT_ACCESS_LOG"
    fi

    if [ -f "$PERF_PROXY_ROOT/logs/error.log" ]; then
        cp -a \
          "$PERF_PROXY_ROOT/logs/error.log" \
          "$CURRENT_NGINX_ERROR"
    fi

    echo "========== 本轮产物 =========="

    ls -lh \
      "$PROXY_LOGIN_CONFIG" \
      "$CURRENT_CONSOLE" \
      "$CURRENT_ACCESS_LOG" \
      "$CURRENT_NGINX_ERROR" \
      "$CURRENT_EXIT_FILE"
}

lt_run_login() {
    local users="${1:?用法：lt_run_login <用户数> [持续秒数]}"
    local duration="${2:-300}"
    local run_exit

    lt_prepare_login "$users" "$duration" || return 1

    cd "$LT_ROOT" || return 1

    set -o pipefail

    ./bin/ltagent \
      -c "$PROXY_LOGIN_CONFIG" \
      -n "$CURRENT_USERS" \
      -d "$CURRENT_DURATION" \
      --user-prefix "$LT_USER_PREFIX" \
      --user-offset="$LT_USER_OFFSET" \
      2>&1 |
    tee "$CURRENT_CONSOLE"

    run_exit=${PIPESTATUS[0]}

    echo "$run_exit" |
    tee "$CURRENT_EXIT_FILE"

    lt_finish_run

    echo "ltagent退出码=$run_exit"

    return "$run_exit"
}

lt_show_current() {
    echo "CURRENT_RUN_ID=${CURRENT_RUN_ID:-未生成}"
    echo "CURRENT_USERS=${CURRENT_USERS:-未生成}"
    echo "CURRENT_DURATION=${CURRENT_DURATION:-未生成}"
    echo "CURRENT_RUN_DIR=${CURRENT_RUN_DIR:-未生成}"
    echo "PROXY_LOGIN_CONFIG=${PROXY_LOGIN_CONFIG:-未生成}"
    echo "CURRENT_CONSOLE=${CURRENT_CONSOLE:-未生成}"
    echo "CURRENT_ACCESS_LOG=${CURRENT_ACCESS_LOG:-未生成}"
}
export LT_METRICS_ADDR=127.0.0.1:4001

if [ -r "$LT_ROOT/runtime/env/monitoring.env" ]; then
    . "$LT_ROOT/runtime/env/monitoring.env"
fi
export FORMAL_USERS=/opt/mattermost-load-test-ng/results/data-preparation/DATA_S01_1200_20260920_180249/imlts01-users-1200.txt
export FORMAL_USERS=/opt/mattermost-load-test-ng/results/data-preparation/DATA_S01_1200_20260920_180249/imlts01-users-1200.txt
export LT_SKIP_SIGNUP=true

# Message performance scenario
export MESSAGE_ACTION_ID=CreatePost
export MESSAGE_RUN_PERIOD=1
export MESSAGE_WAIT_AFTER_MS=1000
export MESSAGE_TEAM_NAME=loadtest-team
export MESSAGE_TEAM_ID=YOUR_TEAM_ID
export MESSAGE_CHANNEL_NAME=town-square
export MESSAGE_CHANNEL_ID=YOUR_CHANNEL_ID
export MESSAGE_CONFIG=/opt/mattermost-load-test-ng/config/formal/config-message-1200.json
export MESSAGE_CONTROLLER_CONFIG=/opt/mattermost-load-test-ng/config/formal/simplecontroller-message.json
[ -r "$LT_ROOT/runtime/env/message-run.env" ] && source "$LT_ROOT/runtime/env/message-run.env"

# S02 Direct Channel单聊场景
export DIRECT_CONFIG="$LT_ROOT/config/formal/config-direct-1200.json"
export DIRECT_CONTROLLER_CONFIG="$LT_ROOT/config/formal/simplecontroller-direct.json"
export DIRECT_EXPECTED_RECEIVERS=2
export DIRECT_WAIT_AFTER_MS=1000
export DIRECT_ACTION_ID=CreateDirectPost

lt_run_direct ()
{
    local users="${1:-}"
    local duration="${2:-}"
    local receivers="${DIRECT_EXPECTED_RECEIVERS:-2}"

    if ! [[ "$users" =~ ^[0-9]+$ ]] || [ "$users" -lt 2 ]; then
        echo "单聊用户数必须是大于等于2的整数"
        echo "用法：lt_run_direct <偶数用户数> <持续秒数>"
        return 1
    fi

    if [ $((users % 2)) -ne 0 ]; then
        echo "单聊用户数必须为偶数，当前=$users"
        echo "本次未启动压测"
        return 1
    fi

    if ! [[ "$duration" =~ ^[0-9]+$ ]] || [ "$duration" -lt 1 ]; then
        echo "持续时间必须是大于0的整数秒"
        echo "本次未启动压测"
        return 1
    fi

    local precheck=PASS

    echo "========== Direct Channel单聊场景执行前检查 =========="

    if [ -r "$DIRECT_CONFIG" ]; then
        echo "单聊主配置=PASS"
    else
        echo "单聊主配置=FAIL：$DIRECT_CONFIG"
        precheck=FAIL
    fi

    if [ -r "$DIRECT_CONTROLLER_CONFIG" ]; then
        echo "单聊Controller=PASS"
    else
        echo "单聊Controller=FAIL：$DIRECT_CONTROLLER_CONFIG"
        precheck=FAIL
    fi

    if [ -r "$FORMAL_USERS" ]; then
        echo "用户文件=PASS"
    else
        echo "用户文件=FAIL：$FORMAL_USERS"
        precheck=FAIL
    fi

    if [ -x "$LT_ROOT/bin/ltagent" ]; then
        echo "ltagent=PASS"
    else
        echo "ltagent=FAIL"
        precheck=FAIL
    fi

    if [ "${LT_SKIP_SIGNUP:-}" = "true" ]; then
        echo "跳过注册开关=PASS"
    else
        echo "跳过注册开关=FAIL：LT_SKIP_SIGNUP=${LT_SKIP_SIGNUP:-空}"
        precheck=FAIL
    fi

    if pgrep -x ltagent >/dev/null 2>&1; then
        echo "旧ltagent进程=FAIL"
        pgrep -a -x ltagent
        precheck=FAIL
    else
        echo "旧ltagent进程=PASS"
    fi

    local proxy_http
    proxy_http=$(
        curl -sS \
          --connect-timeout 3 \
          --max-time 5 \
          -o /tmp/direct-proxy-ping.json \
          -w '%{http_code}' \
          "$PROXY_SERVER_URL/api/v4/system/ping" \
          2>/dev/null
    )

    if [ "$proxy_http" = "200" ]; then
        echo "Nginx代理=PASS"
    else
        echo "Nginx代理=FAIL：HTTP_$proxy_http"
        precheck=FAIL
    fi

    if jq -e '
        (.Actions | length) == 1
        and
        .Actions[0].ActionId == "CreateDirectPost"
    ' "$DIRECT_CONTROLLER_CONFIG" >/dev/null 2>&1
    then
        echo "Direct动作配置=PASS"
    else
        echo "Direct动作配置=FAIL"
        precheck=FAIL
    fi

    echo "Direct配对数=$((users / 2))"
    echo "单条消息预期接收事件数=$receivers"
    echo "单聊场景执行前检查=$precheck"

    if [ "$precheck" != "PASS" ]; then
        echo "本次未启动压测"
        return 1
    fi

    lt_run_monitored_scenario \
      "S02_DIRECT" \
      "$users" \
      "$duration" \
      "$DIRECT_CONFIG" \
      "$DIRECT_CONTROLLER_CONFIG" \
      "$receivers"
}
